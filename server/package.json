{
  "name": "@hackametz/server",
  "version": "0.1.0",
  "private": true,
  "description": "API Express de HackaMetz — MVC : routes / controllers / services / models / repositories / storage",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "kb:export": "tsx src/scripts/kb-export.ts"
  },
  "dependencies": {
    "@hackametz/shared": "*",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "lowdb": "^7.0.1",
    "multer": "^2.4.0",
    "nanoid": "^5.1.16",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "unzipper": "^0.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/supertest": "^6.0.3",
    "@types/unzipper": "^0.10.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "vitest": "^3.2.7"
  }
}
