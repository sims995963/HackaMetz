# Copie ce fichier en .env et adapte les valeurs.

# Serveur Express
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# Fichier de journal (utile quand le serveur tourne en service, sans console).
# Vide = sortie standard.
LOG_FILE=server/logs/hackametz.log

# Origine du front en dev (Vite)
CLIENT_ORIGIN=http://localhost:5173

# Clé secrète de l'organisateur (header X-Admin-Key).
# Génère-la avec « npm run admin-key » — 24 caractères minimum, jamais versionnée.
ADMIN_KEY=

# Politique d'identité par pseudo : device-bound (recommandé) ou free
PSEUDO_POLICY=device-bound

# Chemins relatifs à la racine du projet
DATA_PATH=server/data
STORAGE_PATH=server/storage

# Pont Discord (facultatif) : un salon texte + un vocal par équipe, ouverts avec le code
# d'équipe via /rejoindre, supprimés après la fin de l'édition. Voir deploy/README.md.
# Token du bot (portail développeur Discord) — secret, jamais versionné.
DISCORD_BOT_TOKEN=
# Identifiant du serveur Discord (clic droit sur le serveur → Copier l'identifiant).
DISCORD_GUILD_ID=
# Lien d'invitation au serveur, montré aux participants.
DISCORD_INVITE_URL=
# Heures de grâce après la fin de l'édition avant de supprimer les salons d'équipe.
DISCORD_GRACE_HOURS=48
